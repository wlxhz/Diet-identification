root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,md,yml,yaml,json,js,css,html,xml,gradle,properties}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,js,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,ps1}]
end_of_line = crlf
